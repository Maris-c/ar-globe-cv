{
  "map": {
    "projection": "equirectangular",
    "lon_min": -180.0,
    "lon_max": 180.0,
    "lat_min": -90.0,
    "lat_max": 90.0
  },
  "feature_matching": {
    "orb_n_features": 1500,
    "bf_norm": "NORM_HAMMING",
    "lowe_ratio": 0.75,
    "min_matches": 15,
    "min_inliers": 10,
    "min_inlier_ratio": 0.25,
    "ransac_reproj_threshold": 5.0
  },
  "display": {
    "window_width": 1280,
    "window_height": 720,
    "marker_radius": 8,
    "marker_color": [0, 255, 100],
    "polygon_color": [0, 255, 0],
    "polygon_thickness": 3,
    "font_scale": 0.65,
    "font_color": [255, 255, 255]
  },
  "webcam": {
    "device_index": 0,
    "fps_limit": 30
  },
  "output": {
    "csv_dir": "outputs"
  }
}
